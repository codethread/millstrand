#!/usr/bin/env bash
# Run pinned external spool suites against the invoking millstrand-src checkout.
set -euo pipefail

if [ "$#" -ne 0 ]; then
  echo "spool-suite-gate: unexpected arguments: $*" >&2
  echo "usage: scripts/spool-suite-gate" >&2
  exit 2
fi

root="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
src="$root"
cd "$root"

transition_status="$(clojure -M:transition-check --scope pinned-external-spool-suite)"
case "$transition_status" in
  ACTIVE) ;;
  *)
    echo "spool-suite-gate: transition contract returned unexpected status: $transition_status" >&2
    exit 1
    ;;
esac

coords="$(clojure -M -e '(let [spools (:spools (clojure.edn/read-string (slurp ".millstrand/spools.edn"))) g (fn [family] (let [m (get spools family) sha (:git/sha m) url (:git/url m)] (when-not (and (string? sha) (string? url)) (binding [*out* *err*] (println (str "spool-suite-gate: .millstrand/spools.edn is missing :git/url or :git/sha for family " family "; refusing to run against HEAD/an empty sha"))) (System/exit 1)) [url sha]))] (let [[du ds] (g (quote codethread/devflow)) [ku ks] (g (quote millhouse/spools)) [au as] (g (quote ct.spools/agent-run))] (println du ds ku ks au as) (flush) (System/exit 0)))')"
if [ -z "$coords" ]; then
  echo "spool-suite-gate: coordinate extraction printed nothing for the required external families in .millstrand/spools.edn; refusing to run against HEAD/an empty sha" >&2
  exit 1
fi

read -r durl dsha kurl ksha aurl asha <<<"$coords"
check_pair() {
  if [ -z "$2" ] || [ -z "$3" ]; then
    echo "spool-suite-gate: family $1 extracted an empty url or sha from .millstrand/spools.edn (url=$2 sha=$3); refusing to run" >&2
    exit 1
  fi
}
check_pair devflow "$durl" "$dsha"
check_pair kanban "$kurl" "$ksha"
check_pair agent-run "$aurl" "$asha"

root="$(mktemp -d)"
trap 'rm -rf "$root"' EXIT
ln -s "$src" "$root/millstrand-src"
# Published suites use both historical sibling names for the consumer checkout.
ln -s "$src" "$root/millstrand"
ln -s "$src" "$root/skein-src"

materialize() {
  local name="$1" url="$2" sha="$3" lib="$4"
  local dir="$root/$name"
  local gl="${GITLIBS:-$HOME/.gitlibs}/libs/$lib/$sha"
  if [ -d "$gl" ]; then
    cp -R "$gl" "$dir"
    chmod -R u+w "$dir"
  else
    mkdir -p "$dir"
    git -C "$dir" init -q
    git -C "$dir" remote add origin "$url"
    if ! git -C "$dir" fetch -q --depth 1 origin "$sha"; then
      git -C "$dir" fetch -q origin
    fi
    git -C "$dir" checkout -q "$sha"
  fi
}

materialize devflow.spool "$durl" "$dsha" io.github.codethread/devflow.spool
materialize millhouse.spool "$kurl" "$ksha" millhouse.spools/cron
materialize agent-harness.spool "$aurl" "$asha" io.github.codethread/agent-run.agent-harness

dcmd="clojure -M:test"
kcmd="clojure -Sdeps '{:override-deps {io.millstrand/millstrand {:local/root \"../millstrand-src\"}}}' -M:test millhouse.spools.kanban-test"
acmd="clojure -M:test"
run_suite() {
  local name="$1" sha="$2" command="$3"
  echo "==> spool-suite-gate: $name@$sha${4:-}"
  if ! (cd "$root/$name" && eval "$command"); then
    printf '\n%s\n' "spool-suite-gate: $name@$sha FAILED against millstrand-src HEAD ($src)" >&2
    echo "  reproduce: make spool-suite-gate" >&2
    echo "  or, in a sibling layout with ./millstrand-src beside ./$name, from $name/: $command" >&2
    exit 1
  fi
}

run_suite devflow.spool "$dsha" "$dcmd"
run_suite millhouse.spool "$ksha" "$kcmd"
run_suite agent-harness.spool "$asha" "$acmd"
echo "spool-suite-gate: OK (devflow.spool@$dsha, millhouse.spool Kanban@$ksha, agent-harness.spool@$asha) against millstrand-src HEAD"
