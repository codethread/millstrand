#!/usr/bin/env bash
# Run the pinned Millhouse Workflow consumer suite against this checkout.
set -euo pipefail

if [ "$#" -ne 0 ]; then
  echo "spool-suite-gate: unexpected arguments: $*" >&2
  echo "usage: scripts/spool-suite-gate" >&2
  exit 2
fi

repo_root="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
cd "$repo_root"

coords="$(clojure -M -e '
(require (quote [clojure.edn :as edn])
         (quote [clojure.string :as str]))
(let [coordinate (get-in (edn/read-string (slurp ".millstrand/deps.edn"))
                         [:deps (quote millhouse.spools/workflow)])
      required [:git/url :git/sha :deps/root]
      missing (remove #(and (string? (get coordinate %))
                            (not (str/blank? (get coordinate %))))
                      required)]
  (when (seq missing)
    (binding [*out* *err*]
      (println (str "spool-suite-gate: .millstrand/deps.edn is missing "
                    (pr-str (vec missing))
                    " for millhouse.spools/workflow; refusing to run an unpinned suite")))
    (System/exit 1))
  (println (:git/url coordinate) (:git/sha coordinate) (:deps/root coordinate)))')"
if [ -z "$coords" ]; then
  echo "spool-suite-gate: coordinate extraction printed nothing for millhouse.spools/workflow" >&2
  exit 1
fi

read -r millhouse_url millhouse_sha millhouse_root <<<"$coords"
if [ -z "$millhouse_url" ] || [ -z "$millhouse_sha" ] || [ -z "$millhouse_root" ]; then
  echo "spool-suite-gate: extracted an empty Millhouse URL, SHA, or dependency root" >&2
  exit 1
fi
if [[ ! "$millhouse_sha" =~ ^[0-9a-f]{40}$ ]]; then
  echo "spool-suite-gate: Millhouse Workflow must use a full lowercase Git SHA: $millhouse_sha" >&2
  exit 1
fi

temp_root="$(mktemp -d)"
trap 'rm -rf "${temp_root:?}"' EXIT
millhouse_checkout="$temp_root/millhouse.spool"
gitlib="${GITLIBS:-$HOME/.gitlibs}/libs/millhouse.spools/workflow/$millhouse_sha"

if [ -d "$gitlib" ]; then
  cp -R "$gitlib" "$millhouse_checkout"
  chmod -R u+w "$millhouse_checkout"
else
  mkdir -p "$millhouse_checkout"
  git -C "$millhouse_checkout" init -q
  git -C "$millhouse_checkout" remote add origin "$millhouse_url"
  if ! git -C "$millhouse_checkout" fetch -q --depth 1 origin "$millhouse_sha"; then
    git -C "$millhouse_checkout" fetch -q origin
  fi
  git -C "$millhouse_checkout" checkout -q "$millhouse_sha"
fi

materialized_sha="$(git -C "$millhouse_checkout" rev-parse --verify 'HEAD^{commit}')"
if [ "$materialized_sha" != "$millhouse_sha" ]; then
  echo "spool-suite-gate: materialized Millhouse $materialized_sha, expected $millhouse_sha" >&2
  exit 1
fi
if ! git -C "$millhouse_checkout" diff --quiet HEAD --; then
  echo "spool-suite-gate: materialized Millhouse checkout differs from $millhouse_sha" >&2
  exit 1
fi

consumer_root="$millhouse_checkout/$millhouse_root"
if [ ! -d "$consumer_root" ]; then
  echo "spool-suite-gate: pinned Millhouse dependency root does not exist: $millhouse_root" >&2
  exit 1
fi

ln -s "$repo_root" "$consumer_root/.millstrand-head"
ln -s "$repo_root" "$millhouse_checkout/.millstrand-head"
head_deps='{:deps {io.millstrand/millstrand {:local/root ".millstrand-head"}}
            :aliases {:test {:main-opts ["-m" "millhouse.test-runner"]}}}'
root_head_deps='{:deps {io.millstrand/millstrand {:local/root ".millstrand-head"}}}'
# Workflow's hook tests load the disposable repository's imported configs.
# Generate them from a basis that also replaces Millstrand with this checkout.
root_classpath="$(
  cd "$millhouse_checkout"
  clojure -Sdeps "$root_head_deps" -Spath -M:test
)"
(
  cd "$millhouse_checkout"
  clj-kondo --repro --lint "$root_classpath" --copy-configs --skip-lint
)
resolved_source="$(
  cd "$consumer_root"
  clojure -Sdeps "$head_deps" -M -e '
(require (quote clojure.java.io))
(println (-> "millstrand/repl.clj"
             clojure.java.io/resource
             .toURI
             clojure.java.io/file
             .getCanonicalPath))'
)"
expected_source="$repo_root/src/millstrand/repl.clj"
if [ "$resolved_source" != "$expected_source" ]; then
  echo "spool-suite-gate: Millhouse resolved Millstrand from $resolved_source" >&2
  echo "spool-suite-gate: expected the invoking checkout at $expected_source" >&2
  exit 1
fi

echo "==> spool-suite-gate: millhouse.spools/workflow@$millhouse_sha against $repo_root"
if ! (
  cd "$consumer_root"
  clojure -Sdeps "$head_deps" -M:test \
    millhouse.spools.workflow-test \
    millhouse.spools.workflow-cli-test \
    millhouse.spools.workflow-run-cli-test
); then
  printf '\n%s\n' "spool-suite-gate: Millhouse Workflow@$millhouse_sha FAILED against $repo_root" >&2
  echo "  reproduce: make spool-suite-gate" >&2
  exit 1
fi

echo "spool-suite-gate: OK (Millhouse Workflow@$millhouse_sha) against current HEAD"
