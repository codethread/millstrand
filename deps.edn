{:paths ["src" "dev"]
 :deps {org.clojure/clojure {:mvn/version "1.12.0"}
        com.github.seancorfield/next.jdbc {:mvn/version "1.3.1048"}
        org.xerial/sqlite-jdbc {:mvn/version "3.53.2.0"}
        org.clojure/data.json {:mvn/version "2.5.1"}
        org.clojure/tools.cli {:mvn/version "1.1.230"}
        org.clojure/tools.namespace {:mvn/version "1.5.0"}
        nrepl/nrepl {:mvn/version "1.3.1"}
        org.slf4j/slf4j-nop {:mvn/version "1.7.36"}
        com.bhauman/rebel-readline {:mvn/version "0.1.11"}}
 :aliases
 ;; "scripts" is on the test path so the one-shot cutover scripts under
 ;; scripts/cutover can be exercised by a registered test namespace rather than
 ;; only standalone; the runner's registry, not the classpath, decides what runs.
 {:test {:extra-paths ["test" "scripts" "spools/batteries/src" "spools/workflow/src" "spools/unsafe-text-search/src" "spools/guild/src" "spools/chime/src" "spools/cron/src"]
         :extra-deps {;; Test-only ergonomics: readable nested-map/JSON assertions
                      ;; (match?) and spec-driven property tests (defspec). Kept
                      ;; off the main src/weaver classpath.
                      nubank/matcher-combinators {:mvn/version "3.9.1"}
                      org.clojure/test.check {:mvn/version "1.1.1"}}
         :jvm-opts ["--enable-native-access=ALL-UNNAMED"]
         :main-opts ["-m" "skein.test-runner"]}
  ;; Per-worktree warm test REPL: compose with :test to inherit its classpath and
  ;; native-access opt — `clojure -M:test:test-repl` boots skein.test.warm.
  :test-repl {:main-opts ["-m" "skein.test.warm"]}
  ;; Deliberately self-contained (not composed with :test like :test-repl): the bench
  ;; must run standalone as `clojure -M:large-attr-bench`, and :test's :main-opts
  ;; (skein.test-runner) would swallow the -m entrypoint under composition.
  :large-attr-bench {:extra-paths ["test" "spools/unsafe-text-search/src"]
                     :jvm-opts ["--enable-native-access=ALL-UNNAMED"]
                     :main-opts ["-m" "skein.large-attr-benchmark"]}
  :repl {:jvm-opts ["--enable-native-access=ALL-UNNAMED"]}
  :rebel {:jvm-opts ["--enable-native-access=ALL-UNNAMED"]
          :main-opts ["-m" "rebel-readline.main"]}
  :skein {:jvm-opts ["--enable-native-access=ALL-UNNAMED"]}
  :smoke {:jvm-opts ["--enable-native-access=ALL-UNNAMED"]
          :main-opts ["-m" "skein.smoke"]}
  :format {:extra-deps {dev.weavejester/cljfmt {:mvn/version "0.13.1"}}
           :main-opts ["-m" "cljfmt.main" "check" "src" "spools/batteries/src" "spools/workflow/src" "spools/unsafe-text-search/src" "spools/guild/src" "test" "dev" "scripts"
                       ".skein/init.clj" ".skein/policy/config.clj" ".skein/workflows/support.clj"
                       ".skein/workflows/common.clj" ".skein/workflows/land.clj"
                       ".skein/workflows/spool_bump.clj" ".skein/workflows/story.clj"
                       ".skein/workflows/explore.clj" ".skein/workflows/fix.clj"
                       ".skein/workflows/land_policy.clj" ".skein/workflows/ralph.clj"
                       ".skein/agents/harnesses.clj" ".skein/agents/guide.clj"
                       ".skein/agents/reviewers.clj" ".skein/notifications/attention.clj"
                       ".skein/jobs/nvd_scan.clj" ".skein/adapters/module.clj"]}
  :format/fix {:extra-deps {dev.weavejester/cljfmt {:mvn/version "0.13.1"}}
               :main-opts ["-m" "cljfmt.main" "fix" "src" "spools/batteries/src" "spools/workflow/src" "spools/unsafe-text-search/src" "spools/guild/src" "test" "dev" "scripts"
                           ".skein/init.clj" ".skein/policy/config.clj" ".skein/workflows/support.clj"
                           ".skein/workflows/common.clj" ".skein/workflows/land.clj"
                           ".skein/workflows/spool_bump.clj" ".skein/workflows/story.clj"
                           ".skein/workflows/explore.clj" ".skein/workflows/fix.clj"
                           ".skein/workflows/land_policy.clj" ".skein/workflows/ralph.clj"
                           ".skein/agents/harnesses.clj" ".skein/agents/guide.clj"
                           ".skein/agents/reviewers.clj" ".skein/notifications/attention.clj"
                           ".skein/jobs/nvd_scan.clj" ".skein/adapters/module.clj"]}
  :lint/clj-kondo {:extra-deps {clj-kondo/clj-kondo {:mvn/version "2025.06.05"}}
                   :main-opts ["-m" "clj-kondo.main" "--lint" "src" "spools/batteries/src" "spools/workflow/src" "spools/unsafe-text-search/src" "spools/guild/src" "test"]}
  :lint/conventions {:extra-paths ["scripts"]
                     :extra-deps {clj-kondo/clj-kondo {:mvn/version "2025.06.05"}}
                     :main-opts ["-m" "quality.conventions-check"]}
  :lint/splint {:extra-deps {io.github.noahtheduke/splint {:mvn/version "1.21.0"}}
                :main-opts ["-m" "noahtheduke.splint" "--output" "clj-kondo" "src" "spools/batteries/src" "spools/workflow/src" "spools/unsafe-text-search/src" "spools/guild/src" "test"]}
  :reflect-check {:extra-paths ["scripts" "spools/batteries/src" "spools/workflow/src" "spools/unsafe-text-search/src" "spools/guild/src" "spools/chime/src" "spools/cron/src"]
                  :jvm-opts ["--enable-native-access=ALL-UNNAMED" "-Dclojure.compiler.direct-linking=true"]
                  :main-opts ["-m" "quality.reflect-check"]}
  :deps/antq {:extra-deps {com.github.liquidz/antq {:mvn/version "2.11.1276"}}
              :main-opts ["-m" "antq.core"]}
  :security/clj-watson {:extra-deps {io.github.clj-holmes/clj-watson {:git/tag "v6.1.0" :git/sha "be98e4d"}}
                        :main-opts ["-m" "clj-watson.cli" "scan" "-p" "deps.edn" "-t" "github-advisory"]}
  :security/clj-watson-nvd {:extra-deps {io.github.clj-holmes/clj-watson {:git/tag "v6.1.0" :git/sha "be98e4d"}}
                            :main-opts ["-m" "clj-watson.cli" "scan" "-p" "deps.edn"]}}}
