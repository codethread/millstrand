{:paths ["src" "dev" "resources"]
 :deps {org.clojure/clojure {:mvn/version "1.12.0"}
        com.github.seancorfield/next.jdbc {:mvn/version "1.3.1048"}
        org.xerial/sqlite-jdbc {:mvn/version "3.53.2.0"}
        org.clojure/data.json {:mvn/version "2.5.1"}
        org.clojure/tools.cli {:mvn/version "1.1.230"}
        org.clojure/tools.deps {:mvn/version "0.31.1642"}
        org.clojure/tools.namespace {:mvn/version "1.5.0"}
        nrepl/nrepl {:mvn/version "1.3.1"}
        org.slf4j/slf4j-nop {:mvn/version "1.7.36"}
        com.bhauman/rebel-readline {:mvn/version "0.1.11"}}
 :aliases
 ;; "scripts" is on the test path so the one-shot cutover scripts under
 ;; scripts/cutover can be exercised by a registered test namespace rather than
 ;; only standalone; the runner's registry, not the classpath, decides what runs.
 {:test {:extra-paths ["test/clojure" "scripts" "spools/batteries/src" "spools/unsafe-text-search/src"]
         :extra-deps {;; Test-only ergonomics: readable nested-map/JSON assertions
                      ;; (match?) and spec-driven property tests (defspec). Kept
                      ;; off the main src/weaver classpath.
                      nubank/matcher-combinators {:mvn/version "3.9.1"}
                      millstrand/workspace-config {:local/root ".millstrand"}
                      org.clojure/test.check {:mvn/version "1.1.1"}
                      clj-kondo/clj-kondo {:mvn/version "2026.08.04"}}
         :jvm-opts ["--enable-native-access=ALL-UNNAMED"]
         :main-opts ["-m" "millstrand.test-runner"]}
  ;; Per-worktree warm test REPL: compose with :test to inherit its classpath and
  ;; native-access opt — `clojure -M:test:test-repl` boots millstrand.test.warm.
  :test-repl {:main-opts ["-m" "millstrand.test.warm"]}
  ;; Deliberately self-contained (not composed with :test like :test-repl): the bench
  ;; must run standalone as `clojure -M:large-attr-bench`, and :test's :main-opts
  ;; (millstrand.test-runner) would swallow the -m entrypoint under composition.
  :large-attr-bench {:extra-paths ["test/clojure" "spools/unsafe-text-search/src"]
                     :jvm-opts ["--enable-native-access=ALL-UNNAMED"]
                     :main-opts ["-m" "millstrand.large-attr-benchmark"]}
  :repl {:jvm-opts ["--enable-native-access=ALL-UNNAMED"]}
  :rebel {:jvm-opts ["--enable-native-access=ALL-UNNAMED"]
          :main-opts ["-m" "rebel-readline.main"]}
  :e2e {:extra-paths ["test/clojure/e2e"]
        :jvm-opts ["--enable-native-access=ALL-UNNAMED"]
        :main-opts ["-m" "millstrand.e2e"]}
  :format {:extra-deps {dev.weavejester/cljfmt {:mvn/version "0.13.1"}}
           :main-opts ["-m" "cljfmt.main" "check" "src" "spools/batteries/src" "spools/unsafe-text-search/src" "test/clojure" "dev" "scripts" ".millstrand"]}
  :format/fix {:extra-deps {dev.weavejester/cljfmt {:mvn/version "0.13.1"}}
               :main-opts ["-m" "cljfmt.main" "fix" "src" "spools/batteries/src" "spools/unsafe-text-search/src" "test/clojure" "dev" "scripts" ".millstrand"]}
  :lint/conventions {:extra-paths ["scripts"]
                     :extra-deps {clj-kondo/clj-kondo {:mvn/version "2025.06.05"}}
                     :main-opts ["-m" "quality.conventions-check"]}
  :lint/splint {:extra-deps {io.github.noahtheduke/splint {:mvn/version "1.21.0"}}
                :main-opts ["-m" "noahtheduke.splint" "--output" "clj-kondo" "src" "spools/batteries/src" "spools/unsafe-text-search/src" "test/clojure"]}
  :reflect-check {:extra-paths ["scripts" "spools/batteries/src" "spools/unsafe-text-search/src"]
                  :jvm-opts ["--enable-native-access=ALL-UNNAMED" "-Dclojure.compiler.direct-linking=true"]
                  :main-opts ["-m" "quality.reflect-check"]}
  :deps/antq {:extra-deps {com.github.liquidz/antq {:mvn/version "2.11.1276"}}
              :main-opts ["-m" "antq.core"]}
  :security/clj-watson {:extra-deps {io.github.clj-holmes/clj-watson {:git/tag "v6.1.0"
                                                                      :git/sha "be98e4d"}}
                        :main-opts ["-m" "clj-watson.cli" "scan" "-p" "deps.edn" "-t" "github-advisory"]}
  :security/clj-watson-nvd {:extra-deps {io.github.clj-holmes/clj-watson {:git/tag "v6.1.0"
                                                                          :git/sha "be98e4d"}}
                            :main-opts ["-m" "clj-watson.cli" "scan" "-p" "deps.edn"]}}}
