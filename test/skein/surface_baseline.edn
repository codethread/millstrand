{:op-help
 {"hitl"
  {:schema-version 2,
   :operation
   {:name "hitl",
    :provenance "config",
    :stream? false,
    :raw-envelope false},
   :source {:file ".skein/config.clj", :line 292},
   :glossary {},
   :node
   {:children [],
    :name "hitl",
    :failure-modes [],
    :invocation
    {:mode "declared",
     :flags
     [{:name "backend",
       :flag "--backend",
       :type "string",
       :required false,
       :repeat false,
       :parse nil,
       :doc "Multiplexer backend (default tmux)."}
      {:name "context",
       :flag "--context",
       :type "string",
       :required false,
       :repeat false,
       :parse nil,
       :doc
       "Required session brief: the situation, artifacts, findings, and what to work through together."}
      {:name "cwd",
       :flag "--cwd",
       :type "string",
       :required false,
       :repeat false,
       :parse nil,
       :doc
       "Working directory for the session (defaults to the workspace root)."}
      {:name "harness",
       :flag "--harness",
       :type "string",
       :required false,
       :repeat false,
       :parse nil,
       :doc
       "Interactive-capable harness (prompt-via :arg TUI, e.g. hitl-fable — the default). Headless harnesses like build die in a pane."}],
     :positionals
     [{:name "parent-id",
       :type "string",
       :required true,
       :variadic false,
       :parse nil,
       :doc
       "Strand to hang the tracking strand under (kanban card, plan, or work root)."}
      {:name "title",
       :type "string",
       :required true,
       :variadic false,
       :parse nil,
       :doc "Short session title."}]},
    :deadline-class "standard",
    :notes [],
    :hook-class "mutating",
    :use-when [],
    :doc
    "Open an interactive HITL session: tracking strand + multiplexer run.",
    :returns
    {:type "map",
     :required {"operation" "string"},
     :optional {},
     :extra "json"}}}},
 :queries
 {"feature-active"
  {:params [:feature],
   :where
   [:and
    [:= :state "active"]
    [:= [:attr :feature] [:param :feature]]]},
  "feature-work"
  {:params [:feature],
   :where
   [:and
    [:= :state "active"]
    [:= [:attr :feature] [:param :feature]]
    [:in [:attr :kind] ["task" "review"]]]},
  "feature-owner-work"
  {:params [:feature :owner],
   :where
   [:and
    [:= :state "active"]
    [:= [:attr :feature] [:param :feature]]
    [:= [:attr :owner] [:param :owner]]
    [:in [:attr :kind] ["task" "review"]]]},
  "feature-run"
  {:params [:feature],
   :where
   [:and
    [:= :state "active"]
    [:= [:attr "workflow/run-id"] [:param :feature]]]},
  "workflow-runs"
  [:and [:= :state "active"] [:= [:attr "workflow/role"] "root"]],
  "devflow-runs"
  [:and
   [:= :state "active"]
   [:= [:attr "workflow/role"] "root"]
   [:= [:attr "workflow/family"] "devflow"]],
  "merge-lock"
  [:and [:= :state "active"] [:= [:attr "kind"] "merge-lock"]],
  "work"
  [:and
   [:= :state "active"]
   [:or
    [:missing [:attr "agent-run/run"]]
    [:not [:= [:attr "agent-run/run"] "true"]]]
   [:or
    [:missing [:attr "kanban/lane"]]
    [:not [:= [:attr "kanban/lane"] "refinement"]]]
   [:or
    [:missing [:attr "workflow/role"]]
    [:not
     [:in [:attr "workflow/role"] ["root" "digest" "procedure"]]]]]}}
