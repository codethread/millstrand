{:config-paths ["../resources/clj-kondo.exports/io.millstrand/millstrand"]
 ;; Keep repository policy and third-party compatibility rules here; the
 ;; public Millstrand authoring analysis comes from the classpath export above.
 :lint-as {clojure.test.check.clojure-test/defspec clojure.test/deftest
           ;; defworkflow defines a Var from (name doc opts definition); def's
           ;; shape resolves the name without kondo expanding the macro.
           millstrand.spools.workflow/defworkflow clojure.core/def
           millhouse.spools.workflow/defworkflow clojure.core/def}
 :hooks {:analyze-call {clojure.core/ns hooks.project-rules/ns-docstring
                        ns hooks.project-rules/ns-docstring
                        clojure.core/def hooks.project-rules/no-spool-module-atom
                        def hooks.project-rules/no-spool-module-atom
                        clojure.core/defonce hooks.project-rules/no-spool-module-atom
                        defonce hooks.project-rules/no-spool-module-atom
                        clojure.core/let hooks.project-rules/no-fn-keys-destructure
                        let hooks.project-rules/no-fn-keys-destructure
                        clojure.core/fn hooks.project-rules/no-fn-keys-destructure
                        fn hooks.project-rules/no-fn-keys-destructure
                        clojure.core/defn hooks.project-rules/no-fn-keys-destructure
                        defn hooks.project-rules/no-fn-keys-destructure
                        millstrand.spools.workflow/defexecutor hooks.project-rules/defexecutor
                        millhouse.spools.workflow/defexecutor hooks.project-rules/defexecutor
                        millstrand.macros.rules/defrule hooks.project-rules/defrule}}
 :linters {:project/ns-docstring {:level :error}
           :project/no-spool-module-atom {:level :error}
           :project/no-fn-keys-destructure {:level :error}
           ;; This require is consumed only by syntax-quoted authoring forms in
           ;; eval; kondo cannot resolve that runtime alias.
           :unused-namespace {:exclude [millstrand.api.millstrand.alpha]}
           ;; These test-local private vars are workflow constructors and chime
           ;; rule handlers referenced only by fully-qualified quoted symbol
           ;; (register-workflow!/defrule!), which kondo cannot track — they are
           ;; used, not dead.
           :unused-private-var
           {:exclude [millstrand.spools.workflow-test/toastie-serve-workflow
                      millstrand.spools.workflow-test/pr-fix-ci-workflow
                      millstrand.spools.workflow-test/pr-review-round-workflow
                      millstrand.spools.workflow-test/pr-fix-and-push-workflow
                      millstrand.spools.workflow-test/pr-merge-workflow
                      millstrand.spools.workflow-test/empty-continuation-workflow
                      millstrand.spools.workflow-test/routed-continuation-workflow
                      millstrand.spools.workflow-test/loopy-revision-workflow
                      millstrand.spools.workflow-test/registry-second-stage
                      millstrand.spools.workflow-test/registry-alt-second-stage
                      millstrand.spools.workflow-test/downstream-stage-workflow
                      millstrand.spools.workflow-test/introspect-stage-b-workflow
                      millstrand.spools.workflow-test/bad-defaults-definition
                      millstrand.spools.workflow-test/bad-spec-definition
                      millstrand.spools.workflow-test/unknown-input-definition
                      millstrand.spools.workflow-test/revisable-definition
                      millstrand.spools.workflow-test/revisable-definition-v2
                      millstrand.spools.workflow-test/live-var-definition
                      millstrand.spools.workflow-test/exploding-constructor
                      millstrand.spools.workflow-test/malformed-constructor
                      millstrand.spools.workflow-test/call-only-bound-card
                      millstrand.spools.workflow-test/legacy-bound-card
                      millstrand.spools.workflow-test/defer-caller
                      millstrand.chime-test/throwing-rule
                      millstrand.chime-test/invalid-notification-rule]}}}
